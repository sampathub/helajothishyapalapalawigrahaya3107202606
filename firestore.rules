rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify if user is authenticated and is the strictly authorized admin
    function isAdmin() {
      return request.auth != null 
        && request.auth.token.email_verified == true 
        && request.auth.token.email.lower() == 'sampathub89@gmail.com';
    }

    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Reports collection: Admin has full access. Standard users can only access their own.
    match /reports/{reportId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && resource.data.email == request.auth.token.email);
      allow create, update: if isAdmin() || (isAuthenticated() && request.resource.data.email == request.auth.token.email);
      allow delete: if isAdmin();
    }

    // Config & System tokens collection: Strictly restricted to Admin
    match /config/{configId} {
      allow read, write: if isAdmin();
    }

    // Usage & Chat Quota records: Restricted to Admin or matching user email
    match /usage/{usageId} {
      allow read, write: if isAdmin() || (isAuthenticated() && (usageId == request.auth.token.email || (resource != null && resource.data.email == request.auth.token.email)));
    }

    // Default catch-all rule: Deny all other direct client operations unless admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}



